# Copy to .env. Never commit real keys.
DATABASE_URL=postgresql+psycopg://review:review@localhost:5432/review_desk
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173

# auto = Anthropic if ANTHROPIC_API_KEY is set, otherwise the deterministic fake provider (demo mode)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
FAKE_TOKEN_DELAY_MS=25

RATE_LIMIT_PER_MINUTE=10
MAX_CODE_CHARS=20000
